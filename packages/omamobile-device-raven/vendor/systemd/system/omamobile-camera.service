# Load the camera drivers (hang-safe script; device/raven/CAMERA-PLAN.md
# RC2.5). Started by omamobile-camera.timer, after the boot has settled.
[Unit]
Description=Load the camera drivers (hang-safe)
After=multi-user.target omamobile-aoc.service
ConditionPathExists=/sys/bus/platform/devices/1a450000.csis

[Service]
Type=oneshot
ExecStart=/usr/bin/omamobile-camera-start
RemainAfterExit=yes
