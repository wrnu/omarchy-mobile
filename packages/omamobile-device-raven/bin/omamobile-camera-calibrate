#!/usr/bin/env python3
# SPDX-License-Identifier: MIT
"""Lens shading for raven's ultrawide from its own module's factory data.

The IMX386 module's EEPROM (read-only through at24) holds a factory flat
field: a 17x13 grid per Bayer channel (R, Gr, Gb, B) from edge to edge of
the active area, after three white-balance records (device/raven/
CAMERA-PLAN.md RC3). This fits the software ISP's radial model
(1 + k1 r^2 + k2 r^4 per colour, r over half the diagonal) to that grid,
correcting colour fully and brightness by LUMA_STRENGTH, so that the
corners keep a little of their natural falloff and less amplified noise.

It writes the package's tuning file with this phone's LensShading added to
/etc/libcamera/ipa/simple/imx386.yaml, which libcamera reads before
/usr/share. The numbers belong to this phone's module: never share them.
Run by omamobile-camera-start; it changes nothing if the data fails its
checks, and rewrites the file only when its content changes.

  omamobile-camera-calibrate [--dry-run] [--eeprom FILE] [--base FILE]
"""

import glob
import os
import struct
import sys
import time

EEPROM_NODE = "/soc@0/usi@109200c0/i2c@10920000/eeprom@50"
BASE = "/usr/share/libcamera/ipa/simple/imx386.yaml"
OUT = "/etc/libcamera/ipa/simple/imx386.yaml"
GRID_W, GRID_H = 17, 13
GRID_AT = 0xB8
WB_RECORDS = (0x32, 0x5E, 0x8A)
LUMA_STRENGTH = 0.8


def log(msg):
    print("omamobile-camera-calibrate: " + msg)


def find_eeprom():
    """The EEPROM's nvmem file. at24 probes it from deferred probe once the
    PMIC's LDO1 exists, which udevadm settle doesn't wait for: give an
    enabled node a few seconds."""
    try:
        with open("/sys/firmware/devicetree/base" + EEPROM_NODE + "/status") as f:
            enabled = f.read().rstrip("\0\n") in ("okay", "ok")
    except OSError:
        enabled = os.path.isdir("/sys/firmware/devicetree/base" + EEPROM_NODE)
    for _ in range(50 if enabled else 1):
        for dev in glob.glob("/sys/bus/nvmem/devices/*"):
            node = os.path.realpath(os.path.join(dev, "of_node"))
            if node.endswith(EEPROM_NODE):
                return os.path.join(dev, "nvmem")
        time.sleep(0.1)
    return None


def word(data, offset):
    return struct.unpack_from(">H", data, offset)[0]


def check(data):
    """Why the data can't be used, or None."""
    if len(data) < GRID_AT + 8 * GRID_W * GRID_H + 2:
        return "short read"
    for at in WB_RECORDS:
        if sum(data[at:at + 42]) & 0xFFFF != word(data, at + 42):
            return "white-balance record at 0x%x fails its checksum" % at
    size = 8 * GRID_W * GRID_H
    if sum(data[GRID_AT:GRID_AT + size]) & 0xFFFF != word(data, GRID_AT + size):
        return "lens shading grid fails its checksum"
    return None


def grids(data):
    n = GRID_W * GRID_H
    values = struct.unpack_from(">%dH" % (4 * n), data, GRID_AT)
    return [values[c * n:(c + 1) * n] for c in range(4)]


def fit(r2, gain):
    """Least squares for gain - 1 = k1 r^2 + k2 r^4."""
    a11 = sum(x * x for x in r2)
    a12 = sum(x ** 3 for x in r2)
    a22 = sum(x ** 4 for x in r2)
    b1 = sum(x * (g - 1) for x, g in zip(r2, gain))
    b2 = sum(x * x * (g - 1) for x, g in zip(r2, gain))
    det = a11 * a22 - a12 * a12
    return (b1 * a22 - b2 * a12) / det, (a11 * b2 - a12 * b1) / det


def coefficients(data):
    r_, gr, gb, b_ = grids(data)
    g_ = [(x + y) / 2 for x, y in zip(gr, gb)]
    centre = (GRID_H // 2) * GRID_W + GRID_W // 2
    for grid in (r_, g_, b_):
        if min(grid) <= 0 or max(grid) != grid[centre]:
            raise ValueError("the grid doesn't peak at its centre")
    # Nodes from edge to edge of the 4:3 active area; r over half the diagonal
    r2 = [(((i % GRID_W) / (GRID_W - 1) - 0.5) ** 2 * 16 +
           ((i // GRID_W) / (GRID_H - 1) - 0.5) ** 2 * 9) / 6.25
          for i in range(GRID_W * GRID_H)]
    luma = [g_[centre] / v for v in g_]
    k1, k2 = [], []
    for grid in (r_, g_, b_):
        gain = [(grid[centre] / v) / l * l ** LUMA_STRENGTH
                for v, l in zip(grid, luma)]
        a, b = fit(r2, gain)
        k1.append(a)
        k2.append(b)
    return k1, k2


def tuning(base, k1, k2):
    if "- LensShading:" in base:
        raise ValueError("the package's tuning already has a LensShading")
    marker = "  - Agc:\n"
    if marker not in base:
        raise ValueError("no Agc entry to put LensShading before")
    entry = ("  # This phone's module, from its EEPROM's factory flat field\n"
             "  # (omamobile-camera-calibrate); not for other phones\n"
             "  - LensShading:\n"
             "      k1: [ %s ]\n"
             "      k2: [ %s ]\n" % (", ".join("%.4f" % k for k in k1),
                                     ", ".join("%.4f" % k for k in k2)))
    header = ("# Generated by omamobile-camera-calibrate from %s and this\n"
              "# phone's camera module; rewritten at every camera start.\n" % BASE)
    return header + base.replace(marker, entry + marker, 1)


def main(argv):
    dry_run = "--dry-run" in argv
    path = argv[argv.index("--eeprom") + 1] if "--eeprom" in argv else find_eeprom()
    base = argv[argv.index("--base") + 1] if "--base" in argv else BASE
    if not path:
        log("the ultrawide's EEPROM isn't there (no at24 node); nothing to do")
        return 0
    with open(path, "rb") as f:
        data = f.read(GRID_AT + 8 * GRID_W * GRID_H + 2)
    problem = check(data)
    if problem:
        log("not using the EEPROM: " + problem)
        return 0
    try:
        k1, k2 = coefficients(data)
        with open(base) as f:
            text = tuning(f.read(), k1, k2)
    except (OSError, ValueError) as err:
        log("no lens shading: %s" % err)
        return 0
    if dry_run:
        sys.stdout.write(text)
        return 0
    try:
        with open(OUT) as f:
            if f.read() == text:
                log("lens shading unchanged")
                return 0
    except OSError:
        pass
    os.makedirs(os.path.dirname(OUT), exist_ok=True)
    with open(OUT + ".new", "w") as f:
        f.write(text)
    os.replace(OUT + ".new", OUT)
    log("lens shading from the module's factory data written to " + OUT)
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
