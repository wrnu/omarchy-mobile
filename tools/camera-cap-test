#!/bin/bash
# SPDX-License-Identifier: MIT
#
# camera-cap-test: one CAM3b/CAM4 capture step ON THE PHONE (CAMERA-PLAN.md
# section 7). Run it from the laptop under the stage tool's log stream and
# watchdog:
#
#   tools/camera-stage --watchdog x --cmd 'LINK=2 DMA=0 bash -s' --script tools/camera-cap-test
#   main camera (CAM-M):
#   tools/camera-stage --watchdog x --cmd 'LINK=1 SENSOR=s5kgn1 W=2032 H=1536 DMA=0 bash -s' --script tools/camera-cap-test
#   front (CAM7) and telephoto (CAM-T):
#   tools/camera-stage --watchdog x --cmd 'LINK=0 SENSOR=s5k3j1 W=1920 H=1368 DMA=0 bash -s' --script tools/camera-cap-test
#   tools/camera-stage --watchdog x --cmd 'LINK=4 SENSOR=s5kgm5 W=2016 H=1512 DMA=0 bash -s' --script tools/camera-cap-test
#
# Environment:
#   LINK=n       the CSIS link the overlay enabled (2: camera-stream-link2,
#                1: camera-main, 0: camera-front, 4: camera-tele; the video
#                node is found in the link's media device)
#   SENSOR=      imx386 (default, ultrawide), s5kgn1 (main), s5k3j1 (front)
#                or s5kgm5 (telephoto); the last three are all the s5kgn1
#                module, told apart by their entity names
#   LENS=0|1     load the lens driver too (ak7375, or sem1215 for the
#                telephoto; needed when the overlay set lens-focus:
#                camera-main and camera-tele always, camera-uw-lens);
#                default 1 for s5kgn1 and s5kgm5
#   W=, H=       sensor mode (default 2016x1508, binned 60 fps)
#   DMA=0|1      0: link_only (no DMA, CAM3b); 1: the WDMA writes frames (CAM4)
#   CH=0..3      WDMA channel (CAM4; default 0)
#   PATTERN=n    sensor test pattern (default 2, colour bars; 1 solid colour;
#                0 = image)
#   CTRLS=       more sensor controls for v4l2-ctl --set-ctrl, set before
#                streaming, e.g. "exposure=1700,analogue_gain=240" (';' runs
#                separate calls: "vblank=2090;exposure=3580"), or, with
#                PATTERN=1, "red_pixel_value=256,green_red_pixel_value=512,
#                blue_pixel_value=768,green_blue_pixel_value=1000"
#   FRAMES=n     frames to capture with DMA=1 (default 4), saved to
#                /tmp/cam-<W>x<H>.raw
#   SECS=n       how long to stream (default 5)
#   SENSOR_OPTS= sensor module parameters for one run (it is reloaded)
#   PRE_STREAM=  a command run just before streaming ($SENSOR_DEV: the
#                sensor's I2C device, e.g. 0-003d)
#   CAM=args     hand the camera to libcamera instead: runs cam ARGS once
#                the media graph is up (e.g. CAM="-c1 --capture=10
#                --file=/tmp/uw-#.ppm"); sensor formats and controls are
#                libcamera's, PATTERN and CTRLS are ignored
#   CSIS_OPTS=   extra gs201_csis parameters for one experiment, e.g.
#                "cam_khz=0" (no CAM DVFS vote: CAM3b.5a), "int_khz=0" or
#                "sysreg_link_sel=1" (one per boot)
set -u
LINK=${LINK:?LINK=2, the link the overlay enabled} W=${W:-2016} H=${H:-1508} DMA=${DMA:-0} CH=${CH:-0}
PATTERN=${PATTERN:-2} FRAMES=${FRAMES:-4} SECS=${SECS:-5} CSIS_OPTS=${CSIS_OPTS:-}
CTRLS=${CTRLS:-} SENSOR_OPTS=${SENSOR_OPTS:-} SENSOR=${SENSOR:-imx386}
case "$SENSOR" in
imx386) CODE=SRGGB10_1X10 FOURCC=pRAA MOD=imx386 LENSMOD=ak7375 LENS=${LENS:-0} ;;
s5kgn1) CODE=SGRBG10_1X10 FOURCC=pgAA MOD=s5kgn1 LENSMOD=ak7375 LENS=${LENS:-1} ;;  # GRBG [I]
s5k3j1) CODE=SGRBG10_1X10 FOURCC=pgAA MOD=s5kgn1 LENSMOD= LENS=0 ;;  # GRBG [I]
# GRBG read out vertically flipped (the DT's samsung,vertical-flip) [I]
s5kgm5) CODE=SBGGR10_1X10 FOURCC=pBAA MOD=s5kgn1 LENSMOD=sem1215 LENS=${LENS:-1} ;;
*) echo "SENSOR=imx386, s5kgn1, s5k3j1 or s5kgm5"; exit 1 ;;
esac
say() { echo "cap-test: $*"; echo "cap-test: $*" > /dev/kmsg; }

# raven (device/raven/CAMERA-PLAN.md, RC2.1-RC2.2): the SLG51000 camera PMIC
# needs its bb, buck and pu lines from /run/camera-pmic-gpio (as in
# tools/camera-uw-probe), held for at most 120 s (a dead-man switch), and
# everything is unloaded and powered down again at exit. From RC2.4 the DT
# gives bb and buck to the kernel (the PMIC's vdd supply), and its driver
# powers the chip while an LDO is on: no holder then.
RAVEN=0 PMIC_VDD=0
tr -d '\0' < /sys/firmware/devicetree/base/compatible | grep -c 'google,gs101-raven' >/dev/null && RAVEN=1
[ -e /sys/firmware/devicetree/base/soc@0/usi@109600c0/i2c@10960000/pmic@75/vdd-supply ] && PMIC_VDD=1
raven_off() {
	for m in gs201_csis imx386 slg51000_regulator; do
		grep -c "^$m " /proc/modules >/dev/null || continue
		rmmod $m || { say "rmmod $m failed: the PMIC stays up until a reboot"; fuser -v /dev/video* /dev/media* /dev/v4l-subdev* 2>&1; }
	done
	# the holder lowers pu, then chip select (10 ms), buck, bb
	[ -n "${holder:-}" ] && kill "$holder" 2>/dev/null && wait "$holder"
	say "raven: camera PMIC powered down"
}
if [ "$RAVEN" = 1 ] && [ "$PMIC_VDD" = 1 ]; then
	for m in slg51000_regulator imx386 gs201_csis; do
		grep -c "^$m " /proc/modules >/dev/null && { echo "$m already loaded: reboot first"; exit 1; }
	done
	trap raven_off EXIT
	modprobe slg51000-regulator || { say "modprobe slg51000-regulator failed"; exit 1; }
	sleep 1
	ls -d /sys/bus/i2c/drivers/slg51000-regulator/*-0075 >/dev/null 2>&1 || { say "slg51000 not bound"; exit 1; }
	say "raven: camera PMIC bound, powered by its driver ($(cat /sys/bus/i2c/devices/*-0075/power/runtime_status))"
elif [ "$RAVEN" = 1 ]; then
	[ -r /run/camera-pmic-gpio ] || { echo "copy tools/camera-pmic-gpio to /run/camera-pmic-gpio first"; exit 1; }
	for m in slg51000_regulator imx386 gs201_csis; do
		grep -c "^$m " /proc/modules >/dev/null && { echo "$m already loaded: reboot first"; exit 1; }
	done
	say "raven: bb, buck high, pu low (held at most 120 s)"
	python3 /run/camera-pmic-gpio hold --pu --max 120 &
	holder=$!
	trap raven_off EXIT
	sleep 1
	kill -0 "$holder" 2>/dev/null || { say "hold exited early"; holder=; exit 1; }
	modprobe slg51000-regulator || { say "modprobe slg51000-regulator failed"; exit 1; }
	sleep 1
	ls -d /sys/bus/i2c/drivers/slg51000-regulator/*-0075 >/dev/null 2>&1 || { say "slg51000 not bound"; exit 1; }
	# PU=0: leave pu (S2MPG11 GPIO 4) low, to learn whether anything needs it
	if [ "${PU:-1}" = 1 ]; then
		kill -USR1 "$holder"; sleep 0.2
		say "raven: camera PMIC up, pu high"
	else
		say "raven: camera PMIC up, pu left low (PU=0)"
	fi
fi

# Modules, in order; gs201_csis gets the step's parameters on every run.
modprobe sec_acpm 2>/dev/null
MODS="gpio_s2mpg13 slg51002_regulator $MOD phy_gs201_mipi_dcphy_rx"
[ "$RAVEN" = 1 ] && MODS="$MOD phy_gs201_mipi_dcphy_rx"
[ "$LENS" = 1 ] && MODS="$MODS $LENSMOD"
for m in $MODS; do
	modprobe "$m" || { say "modprobe $m failed"; exit 1; }
done
# the sensor again, fresh, with this run's parameters (none = the defaults)
grep -c '^gs201_csis ' /proc/modules >/dev/null && rmmod gs201_csis
if grep -c "^$MOD " /proc/modules >/dev/null; then
	rmmod "$MOD" || { say "rmmod $MOD failed"; exit 1; }
fi
modprobe "$MOD" $SENSOR_OPTS || { say "modprobe $MOD $SENSOR_OPTS failed"; exit 1; }
grep -c '^gs201_csis ' /proc/modules >/dev/null && rmmod gs201_csis
if [ "$DMA" = 1 ]; then
	modprobe gs201_csis allow_stream=1 link_only=0 wdma_channel="$CH" $CSIS_OPTS
else
	modprobe gs201_csis allow_stream=1 link_only=1 $CSIS_OPTS
fi
sleep 2

MD=
for d in /dev/media*; do
	media-ctl -d "$d" -p 2>/dev/null | grep -q "gs201-csis link $LINK" && MD=$d
done
[ -n "$MD" ] || { say "no media device with gs201-csis link $LINK"; exit 1; }
SENSOR_ENT=$(media-ctl -d "$MD" -p | grep -o "$SENSOR [0-9]*-00[0-9a-f]*" | head -1)
[ -n "$SENSOR_ENT" ] || { say "no $SENSOR entity in $MD"; exit 1; }
CSIS="gs201-csis link $LINK"
WDMA=$(media-ctl -d "$MD" -p | grep -o 'gs201-csis-wdma[0-9]' | head -1)
[ -n "$WDMA" ] || { say "no gs201-csis-wdma entity in $MD"; exit 1; }
VIDEO=$(media-ctl -d "$MD" -e "$WDMA")
SUBDEV=$(media-ctl -d "$MD" -e "$SENSOR_ENT")
NLINKS=$(media-ctl -d "$MD" -p | grep -c -- "-> \"$CSIS\":0")
say "media $MD: '$SENSOR_ENT' -> '$CSIS' -> $VIDEO; sensor->CSIS links: $NLINKS"
[ "$NLINKS" = 1 ] || { say "expected exactly one sensor->CSIS link"; exit 1; }

if [ -n "${CAM:-}" ]; then
	say "libcamera: cam -l; cam $CAM"
	cam -l
	# shellcheck disable=SC2086 # CAM is a list of arguments
	timeout 60 cam $CAM
	say "cam rc=$?"
	DBG=$(ls -d /sys/kernel/debug/$(printf "%x" $((0x1a44 + LINK)))0000.csis 2>/dev/null | head -1)
	[ -n "$DBG" ] && cat "$DBG/stats"
	exit 0
fi

media-ctl -d "$MD" -V "\"$SENSOR_ENT\":0 [fmt:$CODE/${W}x${H}]" || exit 1
media-ctl -d "$MD" -V "\"$CSIS\":0 [fmt:$CODE/${W}x${H}]" || exit 1
media-ctl -d "$MD" --get-v4l2 "\"$SENSOR_ENT\":0"
media-ctl -d "$MD" --get-v4l2 "\"$CSIS\":1"
v4l2-ctl -d "$SUBDEV" --set-ctrl test_pattern="$PATTERN"
# ';' separates calls: a longer frame (vblank) must be set before an
# exposure that needs it, or the exposure is clamped to the old range.
IFS=';' read -ra CTRL_SETS <<< "$CTRLS"
for c in "${CTRL_SETS[@]}"; do
	[ -n "$c" ] || continue
	v4l2-ctl -d "$SUBDEV" --set-ctrl "$c" || { say "controls '$c' refused"; exit 1; }
done
v4l2-ctl -d "$SUBDEV" -l | grep -E "exposure|gain|vblank|test_pattern|pixel_value"
v4l2-ctl -d "$VIDEO" --set-fmt-video=width="$W",height="$H",pixelformat=$FOURCC || exit 1
v4l2-ctl -d "$VIDEO" --get-fmt-video | grep -E "Width|Pixel Format|Bytes per Line|Size Image"

DBG=$(ls -d /sys/kernel/debug/$(printf "%x" $((0x1a44 + LINK)))0000.csis 2>/dev/null | head -1)
# PRE_STREAM=cmd: a bring-up command run just before streaming (e.g. power
# the sensor up first through its runtime PM control); $SENSOR_DEV is its
# I2C device name
SENSOR_DEV=${SENSOR_ENT##* }
if [ -n "${PRE_STREAM:-}" ]; then
	say "pre-stream: $PRE_STREAM"
	eval "$PRE_STREAM"
fi
if [ "$DMA" = 1 ]; then
	OUT=/tmp/cam-${W}x${H}.raw
	say "streaming $FRAMES frames to $OUT (DMA on, channel $CH)"
	timeout "$SECS" v4l2-ctl -d "$VIDEO" --stream-mmap --stream-count="$FRAMES" --stream-to="$OUT"
	ls -l "$OUT" 2>/dev/null
else
	say "streaming ${SECS}s, link only (no DMA)"
	timeout "$SECS" v4l2-ctl -d "$VIDEO" --stream-mmap --stream-count=1000 >/dev/null &
	streamer=$!
	sleep 2
	say "mid-stream state"
	[ -n "$DBG" ] && cat "$DBG/stats" "$DBG/scan"
	cat /sys/kernel/debug/*.phy/regs 2>/dev/null
	# MID=cmd: a bring-up command run mid-stream ($SENSOR_DEV, $SENSOR_BUS:
	# the sensor's I2C device and bus number), followed by the same dump
	# (e.g. stop the sensor's output and see which PHY or link register
	# follows it)
	if [ -n "${MID:-}" ]; then
		SENSOR_BUS=${SENSOR_DEV%%-*}
		say "mid-stream: $MID"
		eval "$MID"
		sleep 0.5
		say "after mid-stream command"
		[ -n "$DBG" ] && cat "$DBG/stats" "$DBG/scan"
		cat /sys/kernel/debug/*.phy/regs 2>/dev/null
	fi
	# only the streamer: on raven the PMIC holder is a background job too
	wait "$streamer"
fi
echo "rc=$?"
[ -n "$DBG" ] && cat "$DBG/stats"
dmesg | grep -E "gs201-csis|dcphy|$MOD|ak7375|sem1215|cap-test" | tail -14
