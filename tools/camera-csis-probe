#!/bin/bash
# SPDX-License-Identifier: MIT
#
# camera-csis-probe: power raven's CSIS block (pd_csis and CMU_TOP's CSIS bus
# clock) through the camera-csis-test overlay's simple-pm-bus and read one
# register, CSIS link 0's version (device/raven/CAMERA-PLAN.md, RC2.0), on
# the phone. Run it under the laptop's log stream and the watchdog:
#
#   tools/camera-stage --watchdog x --cmd 'READ=0 bash -s' --script tools/camera-csis-probe
#
# READ=0 powers the block and checks that genpd, runtime PM and the clock
# all report it on, then powers it off again. No register of the block is
# touched. READ=1 also reads 0x1a440000 once, through a read-only /dev/mem
# mapping (the mapping can't write), and only if every check passed. The
# EXIT trap returns the bus to runtime PM's "auto", which powers it off.
# With camera-csis-pd-test the bus holds no clock: the clock check is
# skipped, the clock is never touched, and READ=1 is refused.
# SMC=1 (camera-csis-smc-test, RC2.0o-p) turns on the PD driver's DTZPC
# save and restore calls to EL3 (exynos_pm_domains.tzpc_smc) for this one
# cycle: the restore after the power-on, the save before the power-off. The
# EXIT trap turns them off again after the power-off.
# PDP=1 (camera-csis-pdp-test, RC2.0q-r) powers pd_pdp on through the
# overlay's second bus before pd_csis, as stock never runs CSIS without
# PDP, and the EXIT trap powers it off after pd_csis.
# READ=cmu1 and READ=cmu (camera-csis-test, RC2.0z) read CMU_CSIS after our
# own power-on: the first of the 56 registers stock saves, or all of them
# (the list camera-csis-abl-probe reads in the bootloader's state). KEEP=1
# leaves the bus held on at exit; HELD=1 then reads a bus that a KEEP=1
# run left on, without powering it again, so that a single-register read
# and the full read share one power-on.
set -u
READ=${READ:-0}
KEEP=${KEEP:-0}
HELD=${HELD:-0}
SMC=${SMC:-0}
PDP=${PDP:-0}
PARAM=/sys/module/exynos_pm_domains/parameters/tzpc_smc
ADDR=0x1a440000
GENPD=/sys/kernel/debug/pm_genpd/pm_genpd_summary
CLK=/sys/kernel/debug/clk/clk_summary
mark() { echo "camera-csis-probe: $*" > /dev/kmsg; echo "== $*"; }
csis_state() { awk '$1 == "csis" { print $2 }' $GENPD; }
pdp_state() { awk '$1 == "pdp" { print $2 }' $GENPD; }
gate() { awk '$1 == "gout_cmu_csis_bus" { print "gout_cmu_csis_bus enable=" $2 " prepare=" $3 " hw=" $9 }' $CLK; }
show() {
  [ "$PDP" = 1 ] && echo "genpd pdp: $(pdp_state)"
  echo "genpd csis: $(csis_state)"
  echo "runtime_status: $(cat $dev/power/runtime_status)"
  gate
}
off() {
  if [ "$KEEP" = 1 ]; then
    mark "KEEP=1: the bus stays on (power/control on)"
    show
    return
  fi
  if [ -n "${dev:-}" ]; then
    echo auto > $dev/power/control
    sleep 0.2
    show
  fi
  if [ "$SMC" = 1 ] && [ -w $PARAM ]; then
    # runtime PM's power-off is asynchronous: wait for the save's line
    for _ in $(seq 20); do
      dmesg | grep -cE 'Power domain csis: DTZPC save' >/dev/null && break
      sleep 0.1
    done
    echo N > $PARAM
    echo "tzpc_smc: $(cat $PARAM)"
  fi
  if [ -n "${pdev:-}" ]; then
    mark "powering pd_pdp off: power/control auto"
    echo auto > $pdev/power/control
    sleep 0.2
    echo "genpd pdp: $(pdp_state)"
  fi
  dmesg | grep -iE 'csis|power domain|simple-pm-bus|abort|SError' | tail -5
}

dev=
for d in /sys/bus/platform/devices/*; do
  case $(readlink -f $d/of_node 2>/dev/null) in */soc@0/bus@1a440000) dev=$d ;; esac
done
[ -n "$dev" ] || { echo "no bus@1a440000: camera-csis-test is not in the running DTB"; exit 1; }
[ "$(basename "$(readlink -f $dev/driver)")" = simple-pm-bus ] || { echo "${dev##*/} has no simple-pm-bus driver: stop"; exit 1; }
if [ "$HELD" = 1 ]; then
  [ "$(cat $dev/power/control)" = on ] || { echo "HELD=1, but power/control is not on: run KEEP=1 first"; exit 1; }
  [ "$(csis_state)" = on ] || { echo "HELD=1, but genpd csis is $(csis_state): stop"; exit 1; }
  [ "$SMC" = 0 ] && [ "$PDP" = 0 ] || { echo "HELD=1 takes no SMC or PDP"; exit 1; }
else
  [ "$(cat $dev/power/control)" = auto ] || { echo "power/control is not auto: something holds the block on: reboot first"; exit 1; }
  [ "$(csis_state)" = off-0 ] || { echo "genpd csis is $(csis_state), not off-0: reboot first"; exit 1; }
fi
case $READ in 0|1|cmu1|cmu) ;; *) echo "READ is 0, 1, cmu1 or cmu"; exit 1 ;; esac
dmesg | grep -cE 'Power domain csis (enable|disable) failed' >/dev/null && { echo "pd_csis failed to switch on this boot: reboot first"; exit 1; }
pdev=
if [ "$PDP" = 1 ]; then
  for d in /sys/bus/platform/devices/*; do
    case $(readlink -f $d/of_node 2>/dev/null) in */soc@0/bus@1aa40000) p=$d ;; esac
  done
  [ -n "${p:-}" ] || { echo "no bus@1aa40000: camera-csis-pdp-test is not in the running DTB"; exit 1; }
  [ "$(basename "$(readlink -f $p/driver)")" = simple-pm-bus ] || { echo "${p##*/} has no simple-pm-bus driver: stop"; exit 1; }
  [ "$(cat $p/power/control)" = auto ] || { echo "the PDP bus's power/control is not auto: reboot first"; exit 1; }
  [ "$(pdp_state)" = off-0 ] || { echo "genpd pdp is $(pdp_state), not off-0: reboot first"; exit 1; }
  dmesg | grep -cE 'Power domain pdp (enable|disable) failed' >/dev/null && { echo "pd_pdp failed to switch this boot: reboot first"; exit 1; }
  echo "pdp bus: ${p##*/}"
fi
if [ "$SMC" = 1 ]; then
  pdn=$(find /proc/device-tree/ -name 'power-domain@17462400' | head -1)
  [ -n "$pdn" ] && [ -e "$pdn/google,tzpc-smc" ] || { echo "pd_csis has no google,tzpc-smc: camera-csis-smc-test is not in the running DTB"; exit 1; }
  [ -w $PARAM ] || { echo "no $PARAM: this kernel has no DTZPC calls"; exit 1; }
  [ "$(cat $PARAM)" = N ] || { echo "tzpc_smc is already on: reboot first"; exit 1; }
  dmesg | grep -cE 'Power domain csis: DTZPC .* smc returned' >/dev/null && { echo "a DTZPC call already ran this boot: reboot first"; exit 1; }
  echo "boot: $(dmesg | grep -cE 'Power domain csis: DTZPC (save|restore) skipped') DTZPC call(s) skipped"
  [ "$READ" = 1 ] && { echo "SMC=1 is a power cycle only: no read"; exit 1; }
fi
clocked=1
[ -e $dev/of_node/clocks ] || clocked=0
[ $clocked = 0 ] && [ "$READ" != 0 ] && { echo "the bus holds no clock (camera-csis-pd-test): no read"; exit 1; }
[ "$SMC" = 1 ] && [ "$READ" != 0 ] && { echo "SMC=1 is a power cycle only: no read"; exit 1; }
echo "bus: ${dev##*/}"
show

trap off EXIT
if [ "$PDP" = 1 ]; then
  mark "pd_pdp on first (runtime PM: power/control on)"
  pdev=$p
  echo on > $pdev/power/control
  sleep 0.2
  [ "$(pdp_state)" = on ] || { echo "genpd pdp did not come on: stop"; exit 1; }
fi
mark "pd_csis on$([ $clocked = 1 ] && echo " and the CSIS bus clock") (runtime PM: power/control on)"
if [ "$SMC" = 1 ]; then
  mark "DTZPC calls on (tzpc_smc=Y): restore after this power-on, save before the power-off"
  echo Y > $PARAM
fi
if [ "$HELD" = 1 ]; then
  mark "HELD=1: pd_csis and the bus clock already on from a KEEP=1 run"
else
  echo on > $dev/power/control; echo "control-exit=$?"
  sleep 0.2
fi
show
ok=1
[ "$(csis_state)" = on ] || { echo "genpd csis did not come on: stop"; ok=0; }
[ "$(cat $dev/power/runtime_status)" = active ] || { echo "the bus is not active: stop"; ok=0; }
[ $clocked = 0 ] || gate | grep -cE 'enable=[1-9].*hw=Y' >/dev/null || { echo "gout_cmu_csis_bus is not on: stop"; ok=0; }
dmesg | grep -iE 'power domain csis' | tail -2

if [ "$READ" = 1 ] && [ $ok = 1 ]; then
  mark "reading $ADDR (CSIS link 0 version), one 32-bit load"
  python3 - $ADDR <<'EOF'
import ctypes, os, sys
addr = int(sys.argv[1], 0)
page = os.sysconf("SC_PAGE_SIZE")
fd = os.open("/dev/mem", os.O_RDONLY | os.O_SYNC)
libc = ctypes.CDLL(None, use_errno=True)
libc.mmap.restype = ctypes.c_void_p
libc.mmap.argtypes = [ctypes.c_void_p, ctypes.c_size_t, ctypes.c_int,
                      ctypes.c_int, ctypes.c_int, ctypes.c_long]
PROT_READ, MAP_SHARED = 1, 1
base = libc.mmap(None, page, PROT_READ, MAP_SHARED, fd, addr & ~(page - 1))
if base is None or base == ctypes.c_void_p(-1).value:
    sys.exit("mmap: " + os.strerror(ctypes.get_errno()))
val = ctypes.c_uint32.from_address(base + (addr & (page - 1))).value
print(f"csis link 0 version: 0x{val:08x}")
EOF
  echo "read-exit=$?"
fi

if [ "${READ#cmu}" != "$READ" ] && [ $ok = 1 ]; then
  mark "READ=$READ: CMU_CSIS after our own power-on, one 32-bit load each"
  python3 - "$READ" <<'EOF'
import ctypes, os, sys
# The registers Google's CAL saves (csis_save), as camera-csis-abl-probe:
# the user mux, the controller option, the BUSP divider, the 51 QCH_CONs,
# then SYSREG_CSIS's DRCG_EN and MEMCLK.
regs = [0x1a400600, 0x1a400800, 0x1a401800]
regs += list(range(0x1a403048, 0x1a403114, 4))
regs += [0x1a420104, 0x1a420108]
assert len(regs) == 56
if sys.argv[1] == "cmu1":
    regs = regs[:1]
page = os.sysconf("SC_PAGE_SIZE")
fd = os.open("/dev/mem", os.O_RDONLY | os.O_SYNC)
libc = ctypes.CDLL(None, use_errno=True)
libc.mmap.restype = ctypes.c_void_p
libc.mmap.argtypes = [ctypes.c_void_p, ctypes.c_size_t, ctypes.c_int,
                      ctypes.c_int, ctypes.c_int, ctypes.c_long]
PROT_READ, MAP_SHARED = 1, 1
maps = {}
for addr in regs:
    base = addr & ~(page - 1)
    if base not in maps:
        m = libc.mmap(None, page, PROT_READ, MAP_SHARED, fd, base)
        if m is None or m == ctypes.c_void_p(-1).value:
            sys.exit("mmap: " + os.strerror(ctypes.get_errno()))
        maps[base] = m
    val = ctypes.c_uint32.from_address(maps[base] + (addr - base)).value
    print(f"0x{addr:08x} = 0x{val:08x}", flush=True)
EOF
  echo "read-exit=$?"
fi
mark "powering off: power/control auto"
