#!/bin/bash
# SPDX-License-Identifier: MIT
#
# camera-csis-cmu-probe: pd_csis cycles with CMU_CSIS restored by the clock
# driver (device/raven/CAMERA-PLAN.md, RC2.0zh), on the phone, with the
# camera-csis-cmu-test overlay. Run it under the laptop's log stream and
# the watchdog:
#
#   tools/camera-stage --watchdog x --cmd 'bash -s' --script tools/camera-csis-cmu-probe
#
# Once per boot: turn the PD driver's DTZPC calls on (tzpc_smc), release
# the kept domain (the save, then its first power-off, from the
# bootloader's state), then twice: power it on through the bus (the
# DTZPC restore, then the CMU's runtime resume through the bus's CMU_CSIS
# clock), read the 56 registers stock saves and compare them with the
# bootloader's (RC2.0x), and power it off again (the CMU's save, then the
# DTZPC save). tzpc_smc is turned off at the end; the PD driver then keeps
# the domain on rather than power it off without a save.
#
# SYSREG=drcg (kernels whose cmu_csis has samsung,sysreg): the clock driver
# sets SYSREG_CSIS's DRCG_EN (all ones) and clears MEMCLK at probe, so those
# two are printed rather than compared with the bootloader's 0 and 1.
#
# Only software counters are read for the clocks (never clk_summary, which
# would runtime-resume the CMU). Each register is one 32-bit load through a
# read-only /dev/mem mapping, only after a clean restore.
set -u
SYSREG=${SYSREG:-boot}
case $SYSREG in boot|drcg) ;; *) echo "SYSREG is boot or drcg"; exit 1 ;; esac
P=/sys/module/exynos_pm_domains/parameters
GENPD=/sys/kernel/debug/pm_genpd/pm_genpd_summary
CLKD=/sys/kernel/debug/clk
mark() { echo "camera-csis-cmu-probe: $*" > /dev/kmsg; echo "== $*"; }
csis_state() { awk '$1 == "csis" { print $2 }' $GENPD; }
cnt() { echo "$1 enable=$(cat $CLKD/$1/clk_enable_count) prepare=$(cat $CLKD/$1/clk_prepare_count)"; }
show() {
  echo "genpd csis: $(csis_state)"
  echo "bus: $(cat $dev/power/runtime_status), cmu: $(cat $cmu/power/runtime_status)"
  echo "tzpc_smc: $(cat $P/tzpc_smc)"
  cnt gout_csis_csis_pclk
  cnt gout_cmu_csis_bus
}
pdlog() { dmesg | grep -E 'Power domain csis|17462400.power-domain|released|1a400000.clock-controller' | tail -"${1:-4}"; }
failed() { dmesg | grep -cE 'Power domain csis (enable|disable) failed|Power domain csis: kept on' >/dev/null; }
# wait up to 2 s for genpd's csis state to read $1
wait_state() {
  for _ in $(seq 20); do
    [ "$(csis_state)" = "$1" ] && return 0
    failed && return 1
    sleep 0.1
  done
  return 1
}
nsave() { dmesg | grep -c 'Power domain csis: DTZPC save 0x1a410204: smc returned 0x0'; }
nrestore() { dmesg | grep -c 'Power domain csis: DTZPC restore 0x1a410204: smc returned 0x0'; }
done_msg() { echo N > $P/tzpc_smc; echo "tzpc_smc: $(cat $P/tzpc_smc)"; dmesg | grep -iE 'abort|SError' | tail -3; }

read_cmu() {
  python3 - "$SYSREG" <<'EOF'
import ctypes, os, sys
# The registers Google's CAL saves (csis_save), with the bootloader's
# values (RC2.0x): the user mux, the controller option, the BUSP divider,
# the 51 QCH_CONs, then SYSREG_CSIS's DRCG_EN and MEMCLK.
want = {0x1a400600: 0x10, 0x1a400800: 0xf1000000, 0x1a401800: 0x1}
for a in range(0x1a403048, 0x1a403114, 4):
    want[a] = 0x003f0002
want[0x1a420104] = 0x0
want[0x1a420108] = 0x1
assert len(want) == 56
shown = {0x1a420104, 0x1a420108} if sys.argv[1] == "drcg" else set()
page = os.sysconf("SC_PAGE_SIZE")
fd = os.open("/dev/mem", os.O_RDONLY | os.O_SYNC)
libc = ctypes.CDLL(None, use_errno=True)
libc.mmap.restype = ctypes.c_void_p
libc.mmap.argtypes = [ctypes.c_void_p, ctypes.c_size_t, ctypes.c_int,
                      ctypes.c_int, ctypes.c_int, ctypes.c_long]
PROT_READ, MAP_SHARED = 1, 1
maps, bad = {}, 0
for addr in sorted(want):
    base = addr & ~(page - 1)
    if base not in maps:
        m = libc.mmap(None, page, PROT_READ, MAP_SHARED, fd, base)
        if m is None or m == ctypes.c_void_p(-1).value:
            sys.exit("mmap: " + os.strerror(ctypes.get_errno()))
        maps[base] = m
    val = ctypes.c_uint32.from_address(maps[base] + (addr - base)).value
    if addr in shown:
        print(f"0x{addr:08x} = 0x{val:08x} (set by the clock driver)", flush=True)
        continue
    if val != want[addr]:
        bad += 1
        print(f"0x{addr:08x} = 0x{val:08x}, the bootloader's 0x{want[addr]:08x}", flush=True)
n = 56 - len(shown)
print(f"{n - bad} of {n} registers equal the bootloader's", flush=True)
EOF
}

dev=
for d in /sys/bus/platform/devices/*; do
  case $(readlink -f $d/of_node 2>/dev/null) in */soc@0/bus@1a440000) dev=$d ;; esac
done
[ -n "$dev" ] || { echo "no bus@1a440000: camera-csis-cmu-test is not in the running DTB"; exit 1; }
[ "$(basename "$(readlink -f $dev/driver)")" = simple-pm-bus ] || { echo "${dev##*/} has no simple-pm-bus driver: stop"; exit 1; }
cmu=/sys/bus/platform/devices/1a400000.clock-controller
[ "$(basename "$(readlink -f $cmu/driver 2>/dev/null)")" = gs101-cmu ] || { echo "CMU_CSIS has no gs101-cmu driver: stop"; exit 1; }
[ -d $CLKD/gout_csis_csis_pclk ] || { echo "no gout_csis_csis_pclk clock: stop"; exit 1; }
pdn=$(find /proc/device-tree/ -name 'power-domain@17462400' | head -1)
[ -n "$pdn" ] && [ -e "$pdn/google,keep-boot-on" ] && [ -e "$pdn/google,tzpc-smc" ] || { echo "pd_csis lacks google,keep-boot-on or google,tzpc-smc: stop"; exit 1; }
[ -w $P/tzpc_smc ] && [ -w $P/release_kept ] || { echo "this kernel has no tzpc_smc or release_kept: stop"; exit 1; }
failed && { echo "pd_csis failed to switch, or was kept on, this boot: reboot first"; exit 1; }
dmesg | grep -c '17462400.power-domain: left as the bootloader left it' >/dev/null || { echo "pd_csis wasn't kept on at boot: stop"; exit 1; }
dmesg | grep -c 'released (release_kept)' >/dev/null && { echo "already released this boot: reboot first"; exit 1; }
dmesg | grep -cE 'Power domain csis: DTZPC .* smc returned' >/dev/null && { echo "a DTZPC call already ran this boot: reboot first"; exit 1; }
[ "$(cat $dev/power/control)" = auto ] || { echo "the bus's power/control is not auto: reboot first"; exit 1; }
[ "$(csis_state)" = on ] || { echo "genpd csis is $(csis_state), not on (kept): stop"; exit 1; }
[ "$(cat $cmu/power/runtime_status)" = suspended ] || { echo "CMU_CSIS is not runtime-suspended: stop"; exit 1; }
[ "$(cat $P/tzpc_smc)" = N ] || { echo "tzpc_smc is already on: reboot first"; exit 1; }
if [ "$SYSREG" = drcg ]; then
  [ -e $cmu/of_node/samsung,sysreg ] || { echo "SYSREG=drcg, but cmu_csis has no samsung,sysreg: stop"; exit 1; }
  dmesg | grep -c 'clock-controller@1a400000: Unable to get CMU sysreg' >/dev/null && { echo "CMU_CSIS didn't get its sysreg: stop"; exit 1; }
fi
echo "bus: ${dev##*/}"
show

trap done_msg EXIT
mark "DTZPC calls on (tzpc_smc=Y); releasing the kept pd_csis: the save, then its first power-off, from the bootloader's state"
echo Y > $P/tzpc_smc
echo 1 > $P/release_kept
if ! wait_state off-0; then
  pdlog 5; show
  echo "pd_csis did not power off from the bootloader's state: stop"
  exit 1
fi
pdlog 3
[ "$(nsave)" = 1 ] || { echo "no clean DTZPC save: stop"; exit 1; }

for cycle in 1 2; do
  mark "cycle $cycle: power/control on: pd_csis on, the DTZPC restore, then CMU_CSIS's runtime resume"
  echo on > $dev/power/control
  sleep 0.2
  show
  pdlog 3
  [ "$(csis_state)" = on ] || { echo "genpd csis did not come on: stop"; exit 1; }
  [ "$(nrestore)" = "$cycle" ] || { echo "no clean DTZPC restore for this power-on: stop, no read"; exit 1; }
  [ "$(cat $dev/power/runtime_status)" = active ] || { echo "the bus is not active: stop"; exit 1; }
  [ "$(cat $cmu/power/runtime_status)" = active ] || { echo "CMU_CSIS did not resume: stop, no read"; exit 1; }

  mark "cycle $cycle: CMU_CSIS after the restores, one 32-bit load each"
  read_cmu
  echo "read-exit=$?"

  mark "cycle $cycle: power/control auto: CMU_CSIS's save, the DTZPC save, then the power-off"
  echo auto > $dev/power/control
  if wait_state off-0; then
    echo "pd_csis powered off"
  else
    echo "pd_csis did not power off"; show; pdlog 5
    exit 1
  fi
  show
  pdlog 3
  [ "$(nsave)" = $((cycle + 1)) ] || { echo "no clean DTZPC save before this power-off: stop"; exit 1; }
done
mark "two cycles done"
