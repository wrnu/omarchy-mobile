# SPDX-License-Identifier: MIT
# Raven-only kernel options, merged after kernel/configs/omamobile.config.
# Some drivers aren't in the published kernel yet; merge_config only warns
# about a symbol a kernel doesn't have, so the published kernel still builds:
# the AoC (omamobile-gs101-aoc), the modem's SPI boot device
# (omamobile-gs101-cpif), the panel (omamobile-gs101-display), the touch
# transport (kernel #8), the thermal sensors (kernel #7) and the haptic
# driver (kernel #114).
# The AoC drivers against gs101's firmware interface (AUDIO-PLAN.md R0).
CONFIG_GOOGLE_AOC_GS101=y
# The modem (S5123) takes its first boot stage over SPI bus 9 before its PCIe
# link (device/raven/MODEM-PLAN.md section 2). Cheetah's CPIF options come
# from kernel/configs/omamobile.config; this adds the SPI boot device.
CONFIG_BOOT_DEVICE_SPI=m
# Raven's own hardware, as modules (BRINGUP-M1.md, DISPLAY-PLAN.md,
# HAPTICS-TORCH-PLAN.md): the S6SY79x touchscreen through s6sy761, the
# S6E3HC3 panel, the gs101 thermal sensors through ACPM and the CS40L25A
# haptics.
CONFIG_TOUCHSCREEN_S6SY761=m
CONFIG_DRM_PANEL_SAMSUNG_S6E3HC3=m
CONFIG_GS101_ACPM_THERMAL=m
CONFIG_INPUT_CS40L25_VIBRA=m
# The camera power path (CAMERA-PLAN.md RC1): the S2MPG11 GPIOs that drive
# the SLG51000 camera PMIC, and its LDOs. Their DT nodes stay disabled until
# the camera overlays.
CONFIG_GPIO_S2MPG11=m
CONFIG_REGULATOR_SLG51000=m
# RC1.3: a regulator-output node in the camera-eeprom-test overlay switches
# the SLG51000's LDO1 from sysfs, so the module EEPROM can be powered and
# read step by step. Bring-up only; it never switches a rail by itself.
CONFIG_REGULATOR_USERSPACE_CONSUMER=m
# ACPM, its mailbox and the PMIC core stay modules on raven: the shared config
# builds them in since #227 (the Pixel 9a's USB PHY), but raven's initramfs
# loads them in order (device.conf INITRAMFS_MODULES) and raven's kernels
# have always run them as modules. Built in, the regulator core's unused-rail
# cleanup (about 30 s after late init) would act on raven's S2MPG10/11 rails
# before their consumers load; that change gets its own boot and plan.
CONFIG_EXYNOS_MBOX=m
CONFIG_EXYNOS_ACPM_PROTOCOL=m
CONFIG_MFD_SEC_ACPM=m
